<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <!-- Type icon -->
        <LinearLayout
            android:id="@+id/vSpotIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_spot_icon"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView
                android:id="@+id/ivSpotIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@color/colorAccent"/>
        </LinearLayout>

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name row with Rec badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">
                <TextView
                    android:id="@+id/tvSpotName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/tvRecBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rec"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:background="@drawable/bg_tag_yellow"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSpotSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#777777"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvSpotDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Right side: avail + heart -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvSpotAvail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:padding="3dp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_tag_green"/>

            <TextView
                android:id="@+id/btnHeart"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:textSize="18sp"
                android:text="♡"
                android:textColor="#CCCCCC"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>