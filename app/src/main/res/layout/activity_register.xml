<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F8">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="&#8249;"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:padding="0dp"
            android:background="@drawable/bg_icon_transparent"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Create Account"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Form scroll -->
    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Name section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Name *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:hint="First name"
                android:textColorHint="#AAAAAA"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Middle Name (optional)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etMiddleName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:hint="Middle name"
                android:textColorHint="#AAAAAA"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Name *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:hint="Last name"
                android:textColorHint="#AAAAAA"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="20dp"/>

            <!-- Role section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="10dp"/>

            <!-- Student / Faculty toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_seg_container"
                android:padding="4dp"
                android:layout_marginBottom="20dp">
                <Button
                    android:id="@+id/btnStudent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Student"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@color/colorPrimary"/>
                <Button
                    android:id="@+id/btnFaculty"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Faculty"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:background="@android:color/transparent"/>
            </LinearLayout>

            <!-- Student details section -->
            <LinearLayout
                android:id="@+id/layoutStudentFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Details"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last 4 digits of Student ID *"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etLastFourId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:hint="e.g. 7890"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:maxLength="4"
                    android:layout_marginBottom="14dp"/>

                <!-- UTA Email preview -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UTA Email (auto-generated)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_email_preview"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="4dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_signout"
                        android:tint="@color/colorPrimary"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/tvEmailPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="xxx0000@mavs.uta.edu"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Format: 3 initials + last 4 of ID + @mavs.uta.edu"
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Major *"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:layout_marginBottom="6dp"/>
                <EditText
                    android:id="@+id/etMajor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:hint="e.g. Computer Science"
                    android:textColorHint="#AAAAAA"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:layout_marginBottom="14dp"/>
            </LinearLayout>

            <!-- Faculty note (hidden by default) -->
            <TextView
                android:id="@+id/tvFacultyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Faculty accounts use your UTA employee credentials. Contact IT for access."
                android:textSize="13sp"
                android:textColor="#555555"
                android:padding="12dp"
                android:background="#FFF8E1"
                android:visibility="gone"
                android:layout_marginBottom="14dp"/>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:hint="Min 6 characters"
                android:textColorHint="#AAAAAA"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp"/>

            <!-- Error message -->
            <TextView
                android:id="@+id/tvRegError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="12sp"
                android:textColor="#C62828"
                android:padding="10dp"
                android:background="@drawable/bg_error"
                android:layout_marginBottom="12dp"/>

            <!-- Create Account button -->
            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Create Account"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@color/colorAccent"
                android:layout_marginBottom="12dp"/>

            <!-- Sign in link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textSize="13sp"
                    android:textColor="#777777"/>
                <TextView
                    android:id="@+id/btnSignInNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign In"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Success screen -->
    <LinearLayout
        android:id="@+id/layoutSuccess"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="#F0F2F8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#10003;"
            android:textSize="56sp"
            android:textColor="#2E7D32"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Created!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="12dp"/>
        <TextView
            android:id="@+id/tvSuccessEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="8dp"
            android:gravity="center"/>
        <Button
            android:id="@+id/btnSignInNowSuccess"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Sign In Now"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@color/colorAccent"/>
    </LinearLayout>

</LinearLayout>